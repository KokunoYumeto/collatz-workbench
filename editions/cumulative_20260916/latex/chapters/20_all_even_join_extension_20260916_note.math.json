  },
  {
    "kind": "DisplayMath",
    "text": "\n\\mathcal E_{b,e,\\sigma}=\\{n>0:n\\equiv r_\\sigma\\pmod{d_\\sigma},\n\\quad Jn+h_e3^b\\equiv0\\pmod Q\\}. \\tag{5}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\nm_0=\\frac{Kn_0+2^ah_e3^b}{Q}-1,\n\\qquad y_0=f_{l_\\sigma}(n_0).\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n\\boxed{\\begin{aligned}\nn(v)&=n_0+d_\\sigma Qv,\\\\\nm(v)&=m_0+d_\\sigma Kv,\\\\\ny(v)&=y_0+\\frac{L_{l_\\sigma}d_\\sigma Q}{U_{l_\\sigma}}v,\n\\qquad v\\in\\mathbb Z_{\\ge0}.\n\\end{aligned}} \\tag{6}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\nw_0=1^a,e,2^{b-1},3,\\qquad\nw_1=1^a,e,2^{b-1},1,1,3. \\tag{7}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\nn(v)\\xrightarrow{l_\\sigma}y(v)\\xleftarrow{w_\\sigma}m(v),\n\\qquad 0<m(v)<n(v),\\qquad\n\\boxed{\\nu_3(n(v))=b+t_e.} \\tag{8}\n"
