  },
  {
    "kind": "DisplayMath",
    "text": "\n -10^9(1+\\log(2m))<\\log\\Lambda<-m\\log2<-(2/3)m.        \\tag{7}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n (2/3)10^{12}>10^9(1+41\\cdot7/10).\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n \\log x=2\\sum_{j=0}^{N-1}\\frac{z^{2j+1}}{2j+1}+R_N,\n \\quad0<R_N<\\frac{2z^{2N+1}}{(2N+1)(1-z^2)}.            \\tag{8}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n \\frac{83130157078217}{52449289519716}\n <\\alpha<\\alpha+2^{-128}\n <\\frac{350861368503572}{221368876767703}.                \\tag{9}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n 0<A_0/m-\\alpha\n =\\log(1+\\Lambda)/(m\\log2)\n <\\frac{3}{2m}2^{-m}<2^{-128}.                          \\tag{10}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n ((2^{A_0}-3^m)+1)2^m-3^m>0.                           \\tag{11}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n g_a(x)=2^{1-a}g_1(x)\\le g_1(x),\\qquad g_1(x)=(3x+1)/2.\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n 0<C/U=f_p(0)\\le2^{1-a_m}\\big((3/2)^m-1\\big).           \\tag{12}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n \\boxed{\\quad C/D<2^{A_m-a_m+1}=2^{A_{m-1}+1}.\\quad}    \\tag{13}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n \\boxed{\n \\{\\rho_p\\}\\quad\\text{when }C\\ge D\\rho_p,\n \\qquad\\varnothing\\quad\\text{when }C<D\\rho_p.\n }                                                       \\tag{14}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n n(t)-f_p(n(t))=\\rho_p-y_p+2Dt.                          \\tag{15}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n 165+268435456t\\longmapsto167+258280326t.                 \\tag{16}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n h=\\lfloor\\log_2(3L)\\rfloor-A_l+1\\ge2.                  \\tag{17}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n M=2^{h-1},\\quad t_0\\equiv-((3y+1)/2)(3L)^{-1}\\pmod M,\n \\quad0\\le t_0<M,\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n n_0=\\rho+2Ut_0,\\quad\n b_0=(3y+1+6Lt_0)/2^h.                                  \\tag{18}\n"
