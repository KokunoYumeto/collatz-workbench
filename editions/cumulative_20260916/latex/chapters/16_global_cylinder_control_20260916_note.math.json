[
  {
    "kind": "DisplayMath",
    "text": "\n T(n)=(3n+1)/2^{a(n)},\\qquad a(n)=\\nu_2(3n+1).\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n A_j=\\sum_{i=1}^ja_i,\\quad A_0=0,\\quad\n U=2^{A_m},\\quad L=3^m,\\quad D=U-L,\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n C=C(p)=\\sum_{j=0}^{m-1}3^{m-1-j}2^{A_j},\\qquad\n f_p(x)=(Lx+C)/U.                                      \\tag{1}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n \\mathcal C_p=\\{\\rho_p+2Ut:t\\in\\mathbb Z_{\\ge0}\\},\\quad\n \\rho_p\\equiv(U-C)L^{-1}\\pmod{2U},\\quad0<\\rho_p<2U.       \\tag{2}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n k\\equiv\\left(2^{a-1}-(3y+1)/2\\right)(3L)^{-1}\\pmod{2^a},\n \\quad0\\le k<2^a.                                      \\tag{3}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n \\boxed{\\quad 2^A-3^m>(3/2)^m-1.\\quad}                  \\tag{4}\n"
