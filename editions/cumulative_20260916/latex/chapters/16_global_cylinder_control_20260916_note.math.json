  {
    "kind": "DisplayMath",
    "text": "\n \\boxed{\n n=n_0+U2^h v,\\quad\n T^{l+1}(n)=\\frac{b_0+3Lv}{2^{\\nu_2(b_0+3Lv)}},\\quad\n a_{l+1}=h+\\nu_2(b_0+3Lv),\\quad v\\ge0.\n }                                                       \\tag{19}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n a^*\\ge h\\quad\\text{and}\\quad (3y+1)/2^{a^*}\\ge\\rho.     \\tag{20}\n"
