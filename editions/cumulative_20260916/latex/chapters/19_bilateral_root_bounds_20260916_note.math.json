  {
    "kind": "DisplayMath",
    "text": "\n \\boxed{\\begin{aligned}\n n(t)&=n_0+32Qt,\\\\\n m(t)&=m_0+32Kt,\\\\\n y(t)&=y_0+54Qt,\\qquad t\\in\\mathbb Z_{\\ge0},\n \\end{aligned}}\n\\tag{12}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n n(t)\\xrightarrow{\\ (1,2,1)\\ }y(t)\n       \\xleftarrow{\\ r_{b,e}\\ }m(t),\\qquad0<m(t)<n(t).\n\\tag{13}\n"
