  },
  {
    "kind": "DisplayMath",
    "text": "\n h_e=(2^e+2)/3\\in\\{2,22\\},\\qquad\n a=a(b,e)=\\min\\{a\\ge1:2^{a+e+2b-1}<3^{a+b}\\},\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n J=2^{e+2b-1},\\quad Q=3^{a+b},\\quad K=2^aJ<Q.\n\\tag{8}\n"
