    "text": "\n a(b,e)\\le b+2e-2,\\qquad\n a(b+1,e)-a(b,e)\\in\\{0,1\\}.\n\\tag{9}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n r_{b,e}=(1)^a,(e),(2)^{b-1},(1),(1),(3).\n\\tag{10}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n \\mathcal S_{b,e}=\\{n>0:n\\equiv27\\pmod{32},\\quad\n                         Jn+h_e3^b\\equiv0\\pmod Q\\}.\n\\tag{11}\n"
  },
  {
    "kind": "DisplayMath",
    "text": "\n m_0=(Kn_0+2^ah_e3^b)/Q-1,\\qquad y_0=(27n_0+23)/16.\n"
