{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim_ledger.schema.json",
  "title": "Atomic mathematical claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "statement",
    "attribution",
    "source_locators",
    "hypotheses",
    "status",
    "checks",
    "dependencies",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{4}$"},
    "statement": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "attribution": {
      "enum": ["siegel", "user_note", "prior_literature", "new_synthesis"]
    },
    "source_locators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/edition_path_locator"},
          {"$ref": "#/$defs/document_locator"}
        ]
      }
    },
    "hypotheses": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
    },
    "status": {
      "enum": [
        "verified_as_stated",
        "verified_corrected",
        "conditional",
        "computational_only",
        "heuristic",
        "contradicted",
        "prior_art_overlap",
        "unresolved"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "result", "detail"],
        "properties": {
          "kind": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
          "result": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
          "detail": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CLM-[0-9]{4}$"}
    },
    "notes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
    }
  },
  "$defs": {
    "nonblank_string": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "edition_path_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {"$ref": "#/$defs/nonblank_string"},
        "path": {
          "type": "string",
          "pattern": "^critical_expository_edition/(?:main\\.tex|chapters/[0-9]{2}_[a-z0-9_]+\\.tex)$"
        },
        "label": {"$ref": "#/$defs/nonblank_string"},
        "lines": {"type": "string", "pattern": "^[1-9][0-9]*-[1-9][0-9]*$"},
        "title": {"$ref": "#/$defs/nonblank_string"}
      },
      "anyOf": [
        {"required": ["label"]},
        {"required": ["lines"]}
      ]
    },
    "document_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "document_id", "version"],
      "properties": {
        "kind": {"$ref": "#/$defs/nonblank_string"},
        "document_id": {"type": "string", "pattern": "^DOC-[0-9]{4}$"},
        "version": {"$ref": "#/$defs/nonblank_string"},
        "locator": {"$ref": "#/$defs/nonblank_string"},
        "lines": {"$ref": "#/$defs/nonblank_string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "oneOf": [
        {"required": ["locator"], "not": {"required": ["lines"]}},
        {"required": ["lines"], "not": {"required": ["locator"]}}
      ]
    }
  }
}
